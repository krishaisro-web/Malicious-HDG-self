# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
.venv*/
venv*/
env*/

# Production Raw and Processed Datasets (gitignored)
data/raw/
data/processed/real/*
!data/processed/real/.gitkeep
data/processed/smoke/*
!data/processed/smoke/.gitkeep

# Production Results and Checkpoints (gitignored)
results/real/*
!results/real/.gitkeep
results/smoke/*
!results/smoke/.gitkeep
artifacts/checkpoints/real/*
!artifacts/checkpoints/real/.gitkeep
artifacts/checkpoints/smoke/*
!artifacts/checkpoints/smoke/.gitkeep

# Large checkpoint weights and archives
artifacts/checkpoints/**/*.pt
artifacts/checkpoints/**/*.tmp
*.tar.gz
results_paper_ready.zip

# Dynamic hardware configuration (generated per-machine at runtime)
configs/active_config.yaml

# Historical folders
data_raw/
data_processed/
data_fixture/
results_fixture/

