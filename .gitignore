# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
.venv*/
venv*/
env*/

# Production Raw and Processed Datasets (gitignored)
data/raw/
data/processed/real/*
!data/processed/real/.gitkeep

# Production Results and Checkpoints (gitignored)
results/real/*
!results/real/.gitkeep
artifacts/checkpoints/real/*
!artifacts/checkpoints/real/.gitkeep

# Large checkpoint weights and archives
artifacts/checkpoints/**/*.pt
*.tar.gz
results_paper_ready.zip

# Historical folders
data_raw/
data_processed/
data_fixture/
results_fixture/
