flowchart LR
    subgraph S1["1. Input Tensors"]
        X_DOM["<b>Domain Features</b><br/>[100k, 17] (FP32)"]
        X_INF["<b>Infra Nodes</b><br/>IP, NS, Reg, ASN, Cert"]
        EDGES["<b>12 Directed Edges</b><br/>[2, 1,369,520]"]
    end

    subgraph S2["2. Layer 1 Conv + Defense"]
        GUARD["<b>GNNGuard Cosine Filter</b><br/>Prunes fake links"]
        CONV1["<b>HeteroConv Layer 1</b><br/>1-hop neighbors (17 -> 64)"]
        ACT1["LeakyReLU + Dropout (0.2)"]
    end

    subgraph S3["3. Layer 2 Conv"]
        CONV2["<b>HeteroConv Layer 2</b><br/>2-hop neighbors (64 -> 32)"]
        ACT2["LeakyReLU + LayerNorm"]
    end

    subgraph S4["4. Decision Head"]
        FC1["Linear Projection<br/>(32 -> 16)"]
        FC2["Output Projection<br/>(16 -> 1)"]
        PRED["<b>Probability p</b><br/>0.0 Safe -> 1.0 Malicious"]
    end

    X_DOM & X_INF & EDGES --> GUARD --> CONV1 --> ACT1 --> CONV2 --> ACT2 --> FC1 --> FC2 --> PRED

